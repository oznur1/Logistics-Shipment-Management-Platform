
:host {
  display: block;
  min-height: 100vh;
  background: #f1f6fd;
  color: #19365f;
  font-family: Arial, Helvetica, sans-serif;
}

* {
  box-sizing: border-box;
}

main {
  width: min(1440px, 96%);
  margin: 0 auto;
  padding: 24px 0 40px;
}

/* Üst başlık */
header {
  position: relative;
  overflow: hidden;
  margin: -24px calc((100vw - min(1440px, 96vw)) / -2) 24px;
  padding: 26px max(3%, calc((100vw - 1440px) / 2 + 24px));
  color: #fff;
  background: linear-gradient(115deg, #173767, #244d85);
  border-radius: 0 0 14px 14px;
  box-shadow: 0 5px 18px rgb(23 55 103 / 15%);
}

header h1 {
  margin: 0 0 8px;
  font-size: clamp(23px, 2.5vw, 32px);
  font-weight: 700;
  letter-spacing: -0.5px;
}

header p {
  margin: 0;
  color: #d7e7ff;
  font-size: 15px;
}

/* Ana paneller */
section {
  margin-bottom: 22px;
  padding: 26px;
  background: #fff;
  border: 1px solid #dfebfb;
  border-radius: 12px;
  box-shadow: 0 4px 16px rgb(34 76 130 / 5%);
}

h2 {
  margin: 0 0 12px;
  color: #173767;
  font-size: 22px;
  font-weight: 700;
}

.form-section > p {
  margin: 0;
  color: #7185a4;
  font-size: 14px;
  line-height: 1.6;
}

/* Sevkiyat oluşturma formu */
form {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px 26px;
  margin-top: 28px;
}

.form-group {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 9px;
}

.form-group label {
  color: #24446f;
  font-size: 14px;
  font-weight: 700;
}

.form-group input {
  width: 100%;
  min-height: 44px;
  padding: 11px 13px;
  border: 1px solid #d4e0f0;
  border-radius: 7px;
  outline: none;
  background: #fff;
  color: #19365f;
  font: inherit;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.form-group input::placeholder {
  color: #9aabc3;
}

.form-group input:hover {
  border-color: #9bb9e8;
}

.form-group input:focus {
  border-color: #3478ed;
  box-shadow: 0 0 0 3px rgb(52 120 237 / 12%);
}

.form-group small {
  color: #7185a4;
  font-size: 12px;
  line-height: 1.5;
}

.error {
  color: #dc2626 !important;
}

.success {
  color: #15803d !important;
}

/* Butonlar */
button {
  justify-self: start;
  align-self: end;
  min-height: 44px;
  padding: 12px 22px;
  border: none;
  border-radius: 7px;
  background: linear-gradient(110deg, #2868e8, #3479f6);
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 3px 8px rgb(37 99 235 / 15%);
  transition: transform 0.15s, box-shadow 0.2s, background 0.2s;
}

button:hover:not(:disabled) {
  background: #1d55cc;
  box-shadow: 0 5px 12px rgb(37 99 235 / 22%);
  transform: translateY(-1px);
}

button:disabled {
  background: #9aacc7;
  box-shadow: none;
  cursor: not-allowed;
}

/* Form geri bildirimleri */
form > p[role="status"] {
  grid-column: 1 / -1;
  margin: 0;
  padding: 14px 16px;
  border: 1px solid #c9efda;
  border-radius: 8px;
  background: #effaf3;
  font-size: 14px;
}

/* Dashboard istatistik kartları */
.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
  margin: 24px 0;
}

.dashboard-card {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 10px;
  padding: 22px;
  border: 1px solid #d9e6fa;
  border-left: 4px solid #3478ed;
  border-radius: 10px;
  background: linear-gradient(135deg, #f7faff, #eaf2ff);
  transition: transform 0.2s, box-shadow 0.2s;
}

.dashboard-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgb(35 75 130 / 9%);
}

.total-card {
  border-color: #c5d9ff;
  border-left-color: #2563eb;
  background: linear-gradient(135deg, #f5f8ff, #e8f0ff);
}

.pending-card {
  border-color: #ffdfaa;
  border-left-color: #e99a12;
  background: linear-gradient(135deg, #fffaf0, #fff3df);
}

.transit-card {
  border-color: #b6e7f8;
  border-left-color: #0891b2;
  background: linear-gradient(135deg, #f0fbff, #e1f6fc);
}

.delivered-card {
  border-color: #c2ecd3;
  border-left-color: #16a34a;
  background: linear-gradient(135deg, #f1fbf5, #e5f7ec);
}

.card-label {
  color: #385477;
  font-size: 14px;
  font-weight: 700;
}

.card-value {
  color: #173767;
  font-size: 34px;
  line-height: 1.2;
  font-weight: 800;
}

.card-description {
  color: #7185a4;
  font-size: 12px;
  line-height: 1.5;
}

/* Tablo */
.table-container {
  width: 100%;
  overflow-x: auto;
  border: 1px solid #e4edf9;
  border-radius: 9px;
}

table {
  width: 100%;
  margin-top: 0;
  border-collapse: collapse;
  white-space: nowrap;
}

th,
td {
  padding: 14px 12px;
  border-bottom: 1px solid #e8eff8;
  text-align: left;
  font-size: 13px;
}

th {
  background: #edf3fd;
  color: #24446f;
  font-weight: 700;
}

td {
  color: #405a7c;
}

tbody tr:nth-child(even) {
  background: #f8fafd;
}

tbody tr {
  transition: background 0.15s;
}

tbody tr:hover {
  background: #edf5ff;
}

tbody tr:last-child td {
  border-bottom: none;
}

/* Sevkiyat durum etiketleri */
.status-badge {
  display: inline-block;
  padding: 5px 10px;
  border: 1px solid transparent;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
}

.status-pending {
  border-color: #ffdfa0;
  background: #fff3d6;
  color: #a96700;
}

.status-transit {
  border-color: #b7d6ff;
  background: #e6f1ff;
  color: #1762cf;
}

.status-delivered {
  border-color: #b7e9cb;
  background: #e1f7e9;
  color: #15803d;
}

/* Yükleniyor mesajı */
.loading {
  padding: 20px;
  color: #2868e8;
  text-align: center;
}

/* Tablet */
@media (max-width: 1000px) {
  form {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .dashboard-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* Telefon */
@media (max-width: 600px) {
  main {
    width: 94%;
    padding: 16px 0 28px;
  }

  header {
    margin: -16px calc((100vw - 94vw) / -2) 18px;
    padding: 24px 5%;
  }

  header h1 {
    font-size: 23px;
    line-height: 1.35;
  }

  section {
    padding: 18px;
    margin-bottom: 18px;
  }

  h2 {
    font-size: 19px;
  }

  form {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .dashboard-card {
    padding: 18px;
  }

  .card-value {
    font-size: 29px;
  }

  th,
  td {
    padding: 12px 10px;
    font-size: 12px;
  }

  button {
    width: 100%;
  }
}


/* Arama ve durum filtreleri */
.filter-section {
  display: flex;
  align-items: flex-end;
  flex-wrap: wrap;
  gap: 20px;
  margin: 24px 0;
  padding: 20px;
  background: #ffffff;
  border: 1px solid #e0e8f2;
  border-radius: 12px;
  box-shadow: 0 4px 12px rgba(25, 54, 95, 0.04);
}

.filter-group {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8px;
  min-width: 220px;
}

.filter-group label {
  color: #24446f;
  font-size: 14px;
  font-weight: 700;
}

.filter-group input,
.filter-group select {
  box-sizing: border-box;
  width: 100%;
  min-height: 44px;
  padding: 11px 14px;
  border: 1px solid #d4e0f0;
  border-radius: 8px;
  background: #ffffff;
  color: #19365f;
  font: inherit;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.filter-group input::placeholder {
  color: #8a9bb2;
}

.filter-group input:focus,
.filter-group select:focus {
  outline: none;
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
}

.empty-message {
  margin: 20px 0;
  padding: 18px;
  border-radius: 8px;
  background: #f8fafc;
  color: #64748b;
  text-align: center;
}

@media (max-width: 600px) {
  .filter-section {
    align-items: stretch;
    flex-direction: column;
    gap: 16px;
    padding: 16px;
  }

  .filter-group {
    min-width: 0;
  }
}
/* Form butonlarını yan yana hizala */
.form-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 8px;
}

/* İptal butonu */
.cancel-button {
  background: #64748b;
  color: white;
}

.cancel-button:hover:not(:disabled) {
  background: #475569;
}

/* Tablo düzenleme butonu */
.edit-button {
  min-height: 34px;
  padding: 7px 12px;
  background: #2563eb;
  color: white;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  font-size: 13px;
  box-shadow: none;
}

.edit-button:hover:not(:disabled) {
  background: #1d4ed8;
}

.edit-button:disabled,
.cancel-button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Sayfalama */
.pagination {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 18px;
}

.pagination-info {
  color: #64748b;
  font-size: 13px;
}

.pagination-controls {
  display: flex;
  align-items: center;
  gap: 10px;
}

.pagination-button {
  min-height: 36px;
  padding: 8px 14px;
  background: #2563eb;
  color: #fff;
  border: none;
  border-radius: 6px;
  font-size: 13px;
}

.pagination-button:disabled {
  background: #cbd5e1;
  cursor: not-allowed;
}

.page-number {
  color: #19365f;
  font-size: 13px;
  font-weight: 700;
}

@media (max-width: 600px) {
  .pagination {
    align-items: stretch;
    flex-direction: column;
  }

  .pagination-controls {
    justify-content: space-between;
  }

  .pagination-button {
    width: auto;
  }
}